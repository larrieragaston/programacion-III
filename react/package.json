{
  "name": "programacion-III-react",
  "private": true,
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /programacion-III/react/",
    "clean:exports": "rm -f pdfs/exports/*.pdf slides-export.pdf *-slides-export.pdf *-export.pdf",
    "export": "npm run clean:exports && mkdir -p pdfs/exports && slidev export --per-slide --output pdfs/exports/react-slides-export.pdf"
  },
  "dependencies": {
    "@slidev/cli": "52.14.1",
    "@slidev/theme-bricks": "^0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.59.1"
  },
  "overrides": {
    "fuse.js": "7.1.0",
    "markdown-exit": "1.0.0-beta.9"
  }
}
